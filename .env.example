# Clawd Connectors — copy to .env and fill in what you use.
# Every value is optional; keyless providers (Backpack, Phoenix, Raydium,
# Sunrise, Clawd catalog/skills) work with an empty .env.

# ── API keys ──────────────────────────────────────────────────────────────
DFLOW_API_KEY=
HELIUS_API_KEY=
JUPITER_API_KEY=
BIRDEYE_API_KEY=

# ── Credentials ───────────────────────────────────────────────────────────
# Imperial trading JWT — a trading credential. Never commit or log it.
IMPERIAL_JWT=
# Pinata JWT for Metaplex metadata pinning (IPFS).
PINATA_JWT=

# ── Endpoints ─────────────────────────────────────────────────────────────
# DAS-capable RPC for Metaplex reads / RPC for Raydium broadcast.
SOLANA_RPC_URL=
# Override the Helius RPC/DAS endpoint (defaults to <network>.helius-rpc.com).
HELIUS_RPC_URL=
HELIUS_NETWORK=mainnet
DFLOW_MCP_URL=
HELIUS_MCP_URL=
JUPITER_MCP_URL=
BIRDEYE_MCP_URL=
CLAWD_MCP_URL=
CLAWD_EQUITIES_MCP_URL=
CLAWD_CONNECTORS_TIMEOUT_MS=15000
# MCP server (clawd-connectors-mcp): stdio by default; http serves
# streamable HTTP on CLAWD_CONNECTORS_MCP_PORT.
CLAWD_CONNECTORS_MCP_TRANSPORT=stdio
CLAWD_CONNECTORS_MCP_PORT=8931

# ── Fail-closed opt-ins (all default OFF) ─────────────────────────────────
# Imperial order placement / cancel / deposit-tx building.
IMPERIAL_ALLOW_TRADING=0
# Jupiter Swap V2 /execute of user-signed swaps.
JUPITER_ALLOW_TRADING=0
# Broadcast user-signed Raydium transactions via RPC.
RAYDIUM_ALLOW_BROADCAST=0
# Submit user-signed transactions via Helius Sender.
HELIUS_ALLOW_BROADCAST=0
